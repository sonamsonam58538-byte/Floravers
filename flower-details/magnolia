        <!-- CARE SECTION -->
        <section class="detail-section">

            <div class="section-title">
                <span class="section-label">MAGNOLIA CARE</span>

                <h2>How to Care for Magnolia</h2>

                <p>
                    Magnolias grow well with adequate sunlight, regular
                    watering and fertile soil with good drainage.
                </p>
            </div>


            <div class="care-grid">

                <div class="care-card">
                    <div class="care-icon">☀️</div>

                    <h3>Sunlight</h3>

                    <p>
                        Plant magnolia in a bright location where it can
                        receive plenty of natural sunlight.
                    </p>
                </div>


                <div class="care-card">
                    <div class="care-icon">💧</div>

                    <h3>Watering</h3>

                    <p>
                        Water regularly, especially while the plant is
                        becoming established. Avoid waterlogged soil.
                    </p>
                </div>


                <div class="care-card">
                    <div class="care-icon">🌱</div>

                    <h3>Soil</h3>

                    <p>
                        Use fertile, well-drained soil that provides
                        enough room for healthy root development.
                    </p>
                </div>


                <div class="care-card">
                    <div class="care-icon">🌿</div>

                    <h3>Maintenance</h3>

                    <p>
                        Keep the area around the plant clean and prune
                        only when necessary to maintain its natural shape.
                    </p>
                </div>

            </div>

        </section>


        <!-- GROWING GUIDE -->
        <section class="detail-section growing-section">

            <div class="section-title">
                <span class="section-label">GROWING GUIDE</span>

                <h2>How to Grow Magnolia</h2>

                <p>
                    Magnolias need enough space to develop and can make
                    beautiful long-term additions to suitable gardens.
                </p>
            </div>


            <div class="growing-guide">

                <div class="guide-step">
                    <span>01</span>

                    <div>
                        <h3>Choose the Location</h3>

                        <p>
                            Select a bright location with enough space
                            for the plant to grow naturally.
                        </p>
                    </div>
                </div>


                <div class="guide-step">
                    <span>02</span>

                    <div>
                        <h3>Prepare the Soil</h3>

                        <p>
                            Use fertile, well-drained soil and prepare
                            enough space for the developing root system.
                        </p>
                    </div>
                </div>


                <div class="guide-step">
                    <span>03</span>

                    <div>
                        <h3>Plant Carefully</h3>

                        <p>
                            Plant the young magnolia carefully and avoid
                            damaging its roots during planting.
                        </p>
                    </div>
                </div>


                <div class="guide-step">
                    <span>04</span>

                    <div>
                        <h3>Provide Regular Care</h3>

                        <p>
                            Give adequate water and sunlight while the
                            plant becomes established.
                        </p>
                    </div>
                </div>

            </div>

        </section>


